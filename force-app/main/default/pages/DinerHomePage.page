        <script type='text/javascript' src='https://orgfarm-036c723453-dev-ed.develop.my.site.com/ESWDinerMessagingChanne1778006016310/assets/js/bootstrap.min.js' onload='initEmbeddedMessaging()'></script>
    </body>
</apex:page>
