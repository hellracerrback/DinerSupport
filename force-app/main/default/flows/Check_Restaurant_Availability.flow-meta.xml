<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>setAvailable</name>
        <label>Set Available</label>
        <locationX>50</locationX>
        <locationY>650</locationY>
        <assignmentItems>
            <assignToReference>isAvailable</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>availabilityResult</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Restaurant is available for your requested date, time, and party size.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>setNotAvailable</name>
        <label>Set Not Available</label>
        <locationX>300</locationX>
        <locationY>650</locationY>
        <assignmentItems>
            <assignToReference>isAvailable</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>availabilityResult</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Sorry, the restaurant does not have capacity for your party size. Please try a different time or a smaller party size.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>setRestaurantMeta</name>
        <label>Store Restaurant Id and Capacity</label>
        <locationX>50</locationX>
        <locationY>410</locationY>
        <assignmentItems>
            <assignToReference>restaurantId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>restaurantRecord.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>restaurantCapacity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>restaurantRecord.Total_Capacity__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>checkCapacity</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>setRestaurantNotFound</name>
        <label>Set Restaurant Not Found</label>
        <locationX>300</locationX>
        <locationY>290</locationY>
        <assignmentItems>
            <assignToReference>isAvailable</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>availabilityResult</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Restaurant not found. Please check the restaurant name and try again.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>checkCapacity</name>
        <label>Check Capacity</label>
        <locationX>50</locationX>
        <locationY>530</locationY>
        <defaultConnector>
            <targetReference>setNotAvailable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Available</defaultConnectorLabel>
        <rules>
            <name>capacityAvailableRule</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>partySize</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>restaurantRecord.Total_Capacity__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>setAvailable</targetReference>
            </connector>
            <label>Available</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkRestaurantFound</name>
        <label>Restaurant Found?</label>
        <locationX>50</locationX>
        <locationY>290</locationY>
        <defaultConnector>
            <targetReference>setRestaurantNotFound</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>restaurantFoundRule</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>restaurantRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>setRestaurantMeta</targetReference>
            </connector>
            <label>Restaurant Found</label>
        </rules>
    </decisions>
    <description>Autolaunched flow used by the Agentforce Diner Support Agent to check restaurant availability for a requested date/time and party size.</description>
    <label>Check Restaurant Availability</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>lookupRestaurant</name>
        <label>Look Up Restaurant</label>
        <locationX>50</locationX>
        <locationY>170</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkRestaurantFound</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>restaurantName</elementReference>
            </value>
        </filters>
        <object>Restaurant__c</object>
        <outputReference>restaurantRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Total_Capacity__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>lookupRestaurant</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>availabilityResult</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>isAvailable</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>partySize</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>requestedDateTime</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>restaurantCapacity</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>restaurantId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>restaurantName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>restaurantRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Restaurant__c</objectType>
    </variables>
</Flow>
